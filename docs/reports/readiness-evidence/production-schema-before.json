  "constraints": [
    {
      "conname": "profiles_admin_assigned_by_fkey",
      "definition": "FOREIGN KEY (admin_assigned_by) REFERENCES profiles(id) ON DELETE SET NULL",
      "table_name": "profiles"
    },
    {
      "conname": "profiles_admin_role_check",
      "definition": "CHECK ((admin_role = ANY (ARRAY['super_admin'::text, 'admin'::text, 'moderator'::text])))",
      "table_name": "profiles"
    },
    {
      "conname": "profiles_email_key",
      "definition": "UNIQUE (email)",
      "table_name": "profiles"
    },
    {
      "conname": "profiles_gender_check",
      "definition": "CHECK ((gender = ANY (ARRAY['male'::text, 'female'::text, 'other'::text, 'prefer_not_to_say'::text])))",
      "table_name": "profiles"
    },
    {
      "conname": "profiles_id_fkey",
      "definition": "FOREIGN KEY (id) REFERENCES auth.users(id) ON DELETE CASCADE",
      "table_name": "profiles"
    },
    {
      "conname": "profiles_pkey",
      "definition": "PRIMARY KEY (id)",
      "table_name": "profiles"
    },
    {
      "conname": "profiles_subscription_tier_check",
      "definition": "CHECK ((subscription_tier = ANY (ARRAY['free'::text, 'lite'::text, 'premium'::text, 'vip'::text])))",
      "table_name": "profiles"
    },
    {
      "conname": "subscriptions_pkey",
      "definition": "PRIMARY KEY (id)",
      "table_name": "subscriptions"
    },
    {
      "conname": "subscriptions_status_check",
      "definition": "CHECK ((status = ANY (ARRAY['active'::text, 'trial'::text, 'cancelled'::text, 'expired'::text])))",
      "table_name": "subscriptions"
    },
    {
      "conname": "subscriptions_tier_check",
      "definition": "CHECK ((tier = ANY (ARRAY['free'::text, 'lite'::text, 'premium'::text, 'vip'::text])))",
      "table_name": "subscriptions"
    },
    {
      "conname": "subscriptions_user_id_fkey",
      "definition": "FOREIGN KEY (user_id) REFERENCES profiles(id) ON DELETE CASCADE",
      "table_name": "subscriptions"
    },
    {
      "conname": "payments_pkey",
      "definition": "PRIMARY KEY (id)",
      "table_name": "payments"
    },
    {
      "conname": "payments_subscription_id_fkey",
      "definition": "FOREIGN KEY (subscription_id) REFERENCES subscriptions(id) ON DELETE SET NULL",
      "table_name": "payments"
    },
    {
      "conname": "payments_user_id_fkey",
      "definition": "FOREIGN KEY (user_id) REFERENCES profiles(id) ON DELETE CASCADE",
      "table_name": "payments"
    }
