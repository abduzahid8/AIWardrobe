# ============================================================
# AIWardrobe — Mobile App Environment Configuration
# ============================================================
#
# SECURITY CONTRACT
# -----------------
# Everything prefixed with EXPO_PUBLIC_ is BUNDLED INTO THE IPA
# and is visible to anyone who downloads the app.
#
# Never put API keys, secrets, or service-role tokens here.
# Provider tokens (NVIDIA, Replicate, Hugging Face, Gemini, etc.)
# MUST live in Supabase `app_config` and be used only by
# Edge Functions. The mobile app calls Edge Functions; the
# Edge Functions call providers.
#
# Anything without EXPO_PUBLIC_ is ignored by Expo and only
# used locally for scripts in /scripts (Node, not the app).
# ============================================================

# --- PUBLIC (safe to bundle in the app) ---------------------

# Supabase project URL and anon key. The anon key is meant to
# be public; security is enforced by Row Level Security (RLS).
# Never put the service role key here — that is a full admin key.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional: custom backend URLs (Express server, AliceVision microservice).
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_ALICEVISION_URL=

# Optional: Sentry DSN (DSNs are public by design).
EXPO_PUBLIC_SENTRY_DSN=

# RevenueCat public SDK key (iOS / Android). Public by design.
EXPO_PUBLIC_REVENUECAT_API_KEY=

# OpenWeather API key. If used on-device, accept that it is
# public; otherwise route weather through an Edge Function.
EXPO_PUBLIC_WEATHER_API_KEY=

# Which AI vision provider Edge Functions should use by default.
# 'gemini' | 'nvidia'. The key itself lives in Supabase, NOT here.
EXPO_PUBLIC_AI_VISION_PROVIDER=gemini

# --- LOCAL-ONLY (scripts under /scripts, never the app) -----
# Used by node-based sync scripts like scripts/sync-zara-men.js.
# These are NOT available in the app because they lack EXPO_PUBLIC_.
APIFY_API_TOKEN=
SUPABASE_SERVICE_KEY=

# ============================================================
# PROVIDER TOKENS — DO NOT PUT HERE
# ============================================================
# Store these in Supabase `app_config` and read them from
# Edge Functions via Deno.env or supabase.from('app_config'):
#
#   INSERT INTO app_config (key, value) VALUES
#     ('nvidia_token',     'nvapi-...'),
#     ('replicate_token',  'r8_...'),
#     ('hf_token',         'hf_...'),
#     ('gemini_api_key',   '...'),
#     ('fashn_api_key',    '...')
#   ON CONFLICT (key) DO UPDATE SET value = EXCLUDED.value;
#
# See docs/SECURITY.md for the full key rotation checklist.
