# AIWardrobe Mobile App - Environment Configuration
# SECURE: API keys stored in Supabase, never in mobile app

# ============================================
# SUPABASE (Database + Auth) - REQUIRED
# Get from: https://supabase.com/dashboard/project/_/settings/api
# ============================================
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# ============================================
# NOTES
# ============================================
# HuggingFace and Replicate API keys are stored SECURELY in Supabase
# Go to Supabase Dashboard → SQL Editor → run:
# INSERT INTO app_config (key, value) VALUES ('hf_token', 'hf_your_token');
# INSERT INTO app_config (key, value) VALUES ('replicate_token', 'r8_your_token');
# 
# This keeps keys secure - mobile app never sees them directly
