{
  "name": "wardrobe-app",
  "version": "1.4.3",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "typecheck": "tsc --noEmit",
    "shop:import-feed": "tsx scripts/import-feed.ts",
    "shop:sync-men": "node scripts/sync-zara-men.js",
    "shop:sync-men:dry": "node scripts/sync-zara-men.js --dry-run",
    "shop:sync-men:quick": "node scripts/sync-zara-men.js --max 20",
    "shop:sync-zara": "node scripts/sync-zara-men.js",
    "shop:sync-zara:dry": "node scripts/sync-zara-men.js --dry-run",
    "shop:sync-zara:quick": "node scripts/sync-zara-men.js --max 20",
    "shop:sync-md": "node scripts/sync-massimo-dutti.js",
    "shop:sync-md:dry": "node scripts/sync-massimo-dutti.js --dry-run",
    "shop:sync-md:quick": "node scripts/sync-massimo-dutti.js --max 20",
    "test:wdio": "wdio run ./wdio.conf.ts",
    "test:maestro": "maestro test .maestro/expo_go_smoke.yaml --no-reinstall-driver",
    "test:e2e": "npm run test:maestro",
    "test:dependency-security": "node --test scripts/validation/dependency-security.test.mjs",
    "test:load-harness": "node --test scripts/load/readiness.test.mjs scripts/load/wear-writes.test.mjs scripts/load/remote-media-probe.test.mjs scripts/load/regional-media.test.mjs scripts/load/diagnostic-error.test.mjs",
    "test:media-rendering": "node --test scripts/validation/private-media-rendering.test.mjs",
    "test:media-durability": "node scripts/validation/pending-media-durability.mjs",
    "test:navigation-links": "node --test scripts/validation/navigation-links.test.mjs",
    "test:release-toolchain": "node --test scripts/validation/release-toolchain.test.mjs",
    "test:native-links": "node --test scripts/validation/native-links.test.mjs",
    "test:asset-formats": "node --test scripts/validation/asset-formats.test.mjs",
    "load:plan": "node scripts/load/readiness.mjs --plan",
    "load:readiness": "node scripts/load/readiness.mjs",
    "typecheck:edge": "deno check --no-config --node-modules-dir=none --lock=backend/supabase/functions/deno.lock --frozen backend/supabase/functions/*/index.ts",
    "test:webdriver-toolchain": "node --test scripts/validation/webdriver-toolchain.test.mjs"
  },
