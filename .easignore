# EAS Build ignore file — excludes files from the tarball
# uploaded to EAS, but keeps .env so EXPO_PUBLIC_* vars are
# embedded in the JS bundle at build time.

# Dependencies (rebuilt on the build server)
node_modules/

# Expo build artifacts
.expo/
dist/
dist-*/
web-build/
expo-env.d.ts
*.hbc

# Metro
.metro-health-check*

# Debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store

# TypeScript incremental
*.tsbuildinfo

# AI training artifacts (if present)
alicevision-service/weights/
alicevision-service/datasets/
alicevision-service/training/

# Scratch / stale directories
Github/
clothing-studio/
colab_tryon/
design-agents/
goal/
pictures/
pitch-deck/
run/
basic_clothing/
tmp/
test/
tests/
uniqlo_test.html
appleconnect_settings.png

# Research & ML training repos — never shipped to the app bundle
CatVTON/
detectron2/
weights/
hf_venv/
.venv-hf-test/
catvton-service/
alicevision-service/
scratch/

# Backend / ML services — NOT part of the mobile app
backend/
cache/
workers/

# Python venvs inside mobile-vton-service (already excluded above, but just in case)
*.venv/
*.venv-modal/

# One-off probes left at repo root
test_*.js
test_*.ts
test-check.js
test-check.ts
test_app_flow.js
test_edge_function.js
test_fallback.js
test_final_step.js
test_flux_*.js
test_full_tryon.js
test_nvidia*.js
test_replicate_*.js
test_resume.js
flux_step*.jpg
tryon_step*.jpg
tryon_step_*.png
catvton_result.png
tryon_result.png
groq_prompt_enhancements.json

# Test coverage
coverage/

# Supabase (edge functions deployed separately, migrations not needed for iOS build; also covered by backend/ above)
supabase/.temp/
supabase/functions/

# Keep the 3D mannequin asset — outfit try-on needs it.
# (If you drop the 3D try-on feature, re-add: assets/models/*.glb)

# Git internals
.git/
.github/

# iOS build artifacts (rebuilt on EAS)
ios/Pods/
ios/build/

# Android build artifacts (rebuilt on EAS)
android/.gradle/
android/build/
android/app/build/

# Maestro test flows
.maestro/

# Logs
*.log
api_server.log

# Docs & meta (not needed for build)
docs/
style-guide/
*.md
!README.md

# WDIO / Appium test infra
__tests__/
wdio.conf.ts

# CI
.github/
ios-backup/
