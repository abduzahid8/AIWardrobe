# AIWardrobe API Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to git

# ============================================
# REQUIRED — Supabase (Auth + DB)
# Get from: https://supabase.com/dashboard/project/_/settings/api
# ============================================
SUPABASE_URL=https://your-project.supabase.co
# Anon key (public, safe for client-side)
SUPABASE_KEY=your-supabase-anon-key
# Service role key (SECRET — server-side only, never expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ============================================
# REQUIRED — MongoDB (wardrobe/outfit data)
# Get from: https://cloud.mongodb.com
# ============================================
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/dbname

# ============================================
# REQUIRED — HuggingFace (primary AI provider)
# Get from: https://huggingface.co/settings/tokens
# Free tier works for all features
# ============================================
HF_TOKEN=hf_your-huggingface-token

# ============================================
# OPTIONAL — Virtual Try-On
# Set this to your HuggingFace Space URL or any try-on API endpoint
# Example: https://your-space.hf.space
# The app works without this — just the try-on feature will show "not configured"
# ============================================
# HF_TRYON_SPACE_URL=https://your-tryon-space.hf.space

# ============================================
# OPTIONAL — Virtual Try-On AI Providers
# Choose your provider based on cost/quality trade-off:
#
# 1. GEMINI (CHEAPEST) - Gemini 2.0 Flash image generation
#    Cost: ~$0.04 per image (6-12x cheaper than FLUX!)
#    Quality: Good for fast iteration, may need refinement
#    Get key: https://ai.google.dev/
#
# 2. NVIDIA FLUX (BEST QUALITY) - FLUX.1-Kontext-dev
#    Cost: ~$0.20-0.50 per image
#    Quality: Excellent, most accurate mannequin preservation
#    Get key: https://build.nvidia.com/
#
# 3. REPLICATE (MIDDLE) - Various VTON models
#    Cost: Varies by model
#    Quality: Good variety of specialized models
#    Get token: https://replicate.com/account/api-tokens
# ============================================
# GEMINI_API_KEY=AIzaSyCbrIqbmTh1Ho1ugVQpGE19FWw0FDccGLg
# NVIDIA_API_KEY_FLUX_1=nvidia-api-key
# REPLICATE_API_TOKEN=r8_your-replicate-token

# ============================================
# OPTIONAL — Legacy API Keys
# ============================================
# OPENAI_API_KEY=sk-your-openai-api-key

# ============================================
# OPTIONAL CONFIGURATION
# ============================================

# Server Port (default: 3000)
PORT=3000

# Node Environment (development/production)
NODE_ENV=development

# Temporary local API auth bypass for development only
# When set to true in NODE_ENV=development, missing Authorization headers are allowed
# DEV_AUTH_BYPASS=false
# DEV_AUTH_BYPASS_USER_ID=dev-bypass-user
# DEV_AUTH_BYPASS_EMAIL=dev-bypass@local.test
# DEV_AUTH_BYPASS_USERNAME=dev_bypass

# Allowed CORS Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:19006

# Weather API Key (OpenWeatherMap)
# Get from: https://openweathermap.org/api
OPENWEATHER_API_KEY=your-openweathermap-api-key

# JWT Secret for auth tokens
JWT_SECRET=your-jwt-secret

# ============================================
# AI VISION SERVICE (local, free)
# ============================================

# AliceVision AI Service URL
# Local: http://localhost:5050
# Production: https://your-alicevision-service.onrender.com
ALICEVISION_URL=http://localhost:5050

# ============================================
# GOOGLE CLOUD - Mobile-VTON Integration
# ============================================

# Google Cloud Project ID
# Get from: https://console.cloud.google.com/projectselector
GOOGLE_CLOUD_PROJECT_ID=steel-autonomy-493310-i5

# Google Cloud Storage Bucket for VTON assets
# Bucket name must be globally unique across GCP
# Recommended: aiwardrobe-vton-assets-{environment}
GOOGLE_CLOUD_VTON_BUCKET=aiwardrobe-vton-prod

# Google Cloud Storage Authentication (recommended: ADC)
# Option A: Application Default Credentials (ADC) - RECOMMENDED
# No env var needed. Just run: gcloud auth application-default login
# This is the most secure method and doesn't require managing keys.

# Option B: Service account key file (NOT recommended - Google blocks this by default)
# GOOGLE_CLOUD_KEY_FILE=/path/to/service-account-key.json

# Option C: Credentials as JSON string (for containerized deployments)
# GOOGLE_CLOUD_CREDENTIALS={"type":"service_account","project_id":"..."}

# Google Cloud Run - Mobile-VTON Service URL
# Deployed Mobile-VTON FastAPI service on Cloud Run
# Example: https://mobile-vton-abcdef.a.run.app
GOOGLE_CLOUD_RUN_MOBILE_VTON_URL=https://mobile-vton-abcdef.a.run.app

# Modal - Mobile-VTON Service URL
# Deployed on Modal Labs serverless GPU (T4)
# Updated: May 29, 2026 (zoxxid75 workspace - active deployment)
MODAL_MOBILE_VTON_URL=https://zoxxid75--aiwardrobe-mobile-vton-fastapi-app.modal.run

# Mobile-VTON Service URL (fallback/local)
# Local: http://localhost:8001
# Cloud Run: Use GOOGLE_CLOUD_RUN_MOBILE_VTON_URL instead
# Modal: Use MODAL_MOBILE_VTON_URL (RECOMMENDED — active deployment)
MOBILE_VTON_SERVICE_URL=https://zoxxid75--aiwardrobe-mobile-vton-fastapi-app.modal.run
