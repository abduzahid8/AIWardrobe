\set user random(1, 10000)
begin;
set local role authenticated;
select set_config('request.jwt.claim.sub', md5('load-user-' || :user)::uuid::text, true);
select set_config('request.jwt.claim.role', 'authenticated', true);
select id, category, image_url from public.clothing_items where user_id = auth.uid() order by created_at desc limit 30;
select id, items from public.saved_outfits where user_id = auth.uid() order by created_at desc limit 20;
select id, username from public.profiles where id = auth.uid();
set local role service_role;
select set_config('request.jwt.claim.role', 'service_role', true);
select public.effective_subscription_tier(md5('load-user-' || :user)::uuid);
select public.increment_rate_bucket(md5('load-user-' || :user)::uuid, 'rl:local-capacity');
commit;
