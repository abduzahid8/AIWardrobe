begin;
set local role service_role;
select set_config('request.jwt.claim.role', 'service_role', true);
select public.apply_revenuecat_snapshots(
  jsonb_build_object('id', 'local-rc-concurrent', 'type', 'INITIAL_PURCHASE',
    'resolved_user_id', md5('load-user-8')::uuid, 'product_id', 'com.aiwardrobe.premium.monthly',
    'transaction_id', 'local-rc-concurrent-txn', 'price', 9.99, 'store', 'APP_STORE'),
  jsonb_build_array(jsonb_build_object('user_id', md5('load-user-8')::uuid,
    'request_date_ms', (extract(epoch from clock_timestamp()) * 1000)::bigint,
    'entitlements', jsonb_build_array(jsonb_build_object('tier', 'premium', 'product_id', 'com.aiwardrobe.premium.monthly',
      'status', 'active', 'start_date', now(), 'end_date', now() + interval '30 days', 'auto_renew', true, 'platform', 'apple')))));
commit;
