receipts.",gmailConnected:"Gmail connected successfully (Simulation)",failedConnectEmail:"Could not connect email. Please try again.",notConnected:"Not connected",connectEmailFirst:"Please connect your email first."},flashSaleEvent:{unableOpenLink:"Unable to open link",productLinkNotOpened:"This product link could not be opened."},flashSales:{hrs:"HRS",min:"MIN",sec:"SEC",live:"LIVE",exclusive:"EXCLUSIVE",shopNow:"Shop Now",loading:"Loading exclusive sales...",title:"Flash Sales",liveBadge:"\ud83d\udd25 LIVE",happeningNow:"\u26a1 Happening Now",comingSoon:"\ud83d\uddd3\ufe0f Coming Soon",startsIn:"Starts in",endsIn:"Ends in",exclusivePieces:"exclusive pieces",exclusiveAccess:"Exclusive Access",sale:"sale",sales:"sales",dontMissOut:"Don't miss out - get notified",infoText:"Premium brands offer their excess inventory at exclusive prices. Limited time, limited stock \u2013 first come, first served.",upToOff:"Up to {{discount}}% off",discountBadge:"-{{discount}}%"},closet:{favorite:"Favorite",all:"All",tops:"Tops",bottoms:"Bottoms",shoes:"Shoes",accessories:"Accessories"},myCloset:{permissionNeeded:"Permission Needed",cameraPermissionRequired:"Camera permission is required to take photos.",simulatorDetected:"Simulator Detected",cameraNotAvailable:"Camera is not available on simulator.",failedOpenCamera:"Failed to open camera.",couldNotReadImage:"Could not read image.",uploadError:"Upload error occurred.",openSettings:"Open Settings",cameraAccessDisabled:"Camera Access Disabled",addToCloset:"Add to Closet",uploadPhotoDescription:"Choose a photo or use the camera to identify clothing. Your original photo is kept.",aiStudioPhoto:"AI Studio Photo",aiStudioCamera:"AI Studio Camera",legacyCamera:"Standard camera",deleteItem:"Delete Item",deleteItemConfirmation:"Are you sure you want to delete this clothing piece? This action cannot be undone.",searchCloset:"Search closet...",uploadClothing:"Upload clothing",createFirstCollection:"Create first collection",scanWardrobe:"Scan wardrobe",askAIStylist:"Ask AI Stylist",enableCameraAccess:"Enable camera access in Settings to continue.",analyzingItem:"Analyzing item and removing background...",identifyingType:"Identifying clothing type...",backgroundRemoved:"Background removed. Review details...",analyzingClothing:"AI is analyzing your clothing...",failedDeleteItem:"Failed to delete item. It has been restored to your wardrobe."},outfitInspo:{title:"Outfit Inspiration",uploadTitle:"Upload a photo",uploadSubtitleOutfit:"Take a photo of an outfit you like and AI will find similar items from your wardrobe and shop.",uploadSubtitleSingle:"Take a photo of a clothing item and AI will find similar or better alternatives.",takePhoto:"Take Photo",chooseGallery:"Choose from Gallery",changePhoto:"Change",fullOutfit:"Full Outfit",findSimilar:"Find Similar",analyzeOutfit:"Analyze Outfit",findSimilarItems:"Find Similar Items",analyzingOutfit:"Analyzing your outfit...",findingSimilar:"Finding similar items...",takesMoment:"This may take a few seconds",detectedItems:"Detected Items",fromYourWardrobe:"From Your Wardrobe",shopRecommendations:"Shop Recommendations",noMatchesFound:"No similar items found yet. Add more items to your wardrobe!",analysisFailed:"Could not analyze the image. Please try again.",item:"Item",tryAgain:"Try Again",cameraPermission:"Camera Permission",cameraPermissionMsg:"Allow camera access to take a photo of your outfit.",photoPermission:"Photo Permission",photoPermissionMsg:"Allow photo library access to select an outfit photo.",imagePickError:"Failed to pick image. Please try again.",shareMessage:"Check out this outfit analysis from AIWardrobe!"},aiAssistant:{noResponseText:"No response text from server",couldntConnect:"Sorry, I couldn't connect to the style server. Please try again! \ud83d\ude14"},outfitAI:{suggestOutfitIdeas:"Let me suggest some outfit ideas for you!",troubleConnecting:"I'm having trouble connecting right now. Make sure the AI service is running and try again!",describeOccasion:"Describe your occasion...",adjustUntilRight:"Adjust until right"},privacyPolicy:{title:"Privacy Policy",lastUpdated:"Last updated: March 2026",intro:"AIWardrobe (\"we\", \"our\", \"us\") is committed to protecting your privacy. This Privacy Policy explains how we collect, use, and safeguard your information when you use our mobile application.",informationWeCollect:{title:"1. Information we collect",body:"We collect only the information needed to provide core features.\n\n\u2022 Account information: email, username, and authentication identifiers when you sign up or sign in.\n\u2022 Wardrobe content you provide: photos/videos you choose to upload or capture, and item metadata you add or edit (e.g., category, color, brand, notes).\n\u2022 AI feature inputs: images and text you submit for wardrobe scan, outfit generation, or virtual try-on.\n\u2022 Approximate location (optional): when you grant location permission, we use your current location to fetch local weather for outfit suggestions.\n\u2022 Purchase/subscription data: subscription status and purchase events (processed by Apple and our subscription provider).\n\u2022 Diagnostics (optional): crash logs and performance data to improve reliability."},howWeUse:{title:"2. How we use information",body:"We use your information to:\n\n\u2022 Provide wardrobe scanning, outfit recommendations, and virtual try-on.\n\u2022 Sync your wardrobe across devices when you are signed in.\n\u2022 Personalize suggestions based on the items you add and the context you provide (like weather).\n\u2022 Provide customer support and respond to requests.\n\u2022 Prevent abuse and secure our service.\n\u2022 Improve app performance, stability, and feature quality.\n\nIf you enable analytics sharing, we also use anonymized usage events to understand which features work well and to fix issues."},dataStorage:{title:"3. Data storage and retention",body:"Your account and wardrobe data may be stored in our cloud database and storage.\n\nWe keep data only as long as needed to provide the service or as required by law. You can request deletion by deleting your account in the app. After account deletion, we delete associated wardrobe items and uploaded media, subject to limited legal/operational retention (e.g., fraud prevention, backups for a short period)."},thirdParty:{title:"4. Third-party services and AI processing",body:"To deliver AI features, we may process your inputs (such as selected photos) through our servers and trusted third-party providers.\n\nDepending on the feature, this can include:\n\u2022 Cloud infrastructure and database (for authentication, storage, and syncing).\n\u2022 AI providers (for image understanding, background removal, generation, and try-on rendering).\n\u2022 Weather providers (when you enable location-based weather).\n\u2022 Crash/diagnostic providers (if enabled).\n\u2022 Affiliate / shopping links: when you tap a product link, we may record an event such as \"product clicked\" for analytics and attribution.\n\nWe do not sell your personal information. We only share data with service providers to operate and improve the app, and we require them to protect your data."},yourRights:{title:"5. Your choices and rights",body:"You can:\n\n\u2022 Use many features without sharing optional permissions.\n\u2022 Control permissions in iOS Settings (Camera, Photos, Location, Microphone).\n\u2022 Turn analytics sharing on/off in the app settings.\n\u2022 Access and update your profile details in the app.\n\u2022 Delete your account in the app to request deletion of your data.\n\nIf you need help with access or deletion requests, contact us using the details below."},childrensPrivacy:{title:"6. Children\u2019s privacy",body:"AIWardrobe is not intended for children under 13. If you believe a child has provided personal information, contact us so we can take appropriate action."},changes:{title:"7. Changes to this Privacy Policy",body:"We may update this policy from time to time. We will update the \u201cLast updated\u201d date and may provide additional notice in the app when changes are significant."},contact:{title:"8. Contact",body:"If you have questions about privacy or data deletion, contact us at: support@aiwardrobe.club"}},review:{error:"Error",notAuthorized:"You are not authorized",done:"Done! \ud83c\udf89",removeItem:"Remove Item",confirmRemove:"Are you sure you want to remove this item?",generating:"Generating clothes...",savingToCloud:"Drawing photos and saving to cloud",itemsAdded:"{{count}} items added. Now creating beautiful photos for them.",saveFailed:"Failed to save items: {{error}}",itemsFound:"{{count}} items found",addToWardrobe:"Add to wardrobe ({{count}})"},termsOfService:{title:"Terms of Service",lastUpdated:"Last updated: March 2026",intro:"Please read these Terms of Service carefully before using AIWardrobe.",acceptance:{title:"1. Acceptance of terms",body:"By using AIWardrobe, you agree to these Terms. If you do not agree, do not use the app."},description:{title:"2. Service description",body:"AIWardrobe helps you organize a digital wardrobe, generate outfit ideas, and create virtual try-on previews. Some features require an internet connection and may rely on third-party services."},userAccounts:{title:"3. User accounts",body:"You are responsible for maintaining the confidentiality of your account. You must provide accurate information and keep it up to date. You can delete your account in the app."},userContent:{title:"4. Your content",body:"You retain rights to the photos, videos, and content you upload. You grant us permission to process your content to provide app features (including AI processing) and to store it as needed for syncing and retrieval."},subscriptions:{title:"5. Subscriptions and payments",body:"If you purchase a subscription, payment is processed through Apple\u2019s in-app purchase system. Subscriptions renew and can be managed or canceled in your Apple ID settings. If you experience billing issues, contact Apple support and/or us for help."},aiContent:{title:"6. AI features and outputs",body:"AI outputs (such as recommendations or try-on previews) are generated automatically and may be inaccurate. Use your judgment before relying on AI results. Do not upload content you do not have the right to use."},prohibited:{title:"7. Prohibited use",body:"You agree not to misuse the app, interfere with the service, attempt unauthorized access, or upload illegal, harmful, or infringing content."},intellectual:{title:"8. Intellectual property",body:"The AIWardrobe app, branding, and software are owned by us and protected by intellectual property laws. You may not copy, modify, distribute, or reverse engineer the app except as permitted by law."},liability:{title:"9. Disclaimer and limitation of liability",body:"The app is provided \u201cas is\u201d without warranties. To the maximum extent permitted by law, we are not liable for indirect or consequential damages arising from your use of the app."},changes:{title:"10. Changes to these Terms",body:"We may update these Terms from time to time. Continued use of the app after changes means you accept the updated Terms."},contact:{title:"11. Contact",body:"Questions about these Terms? Contact us at: support@aiwardrobe.club"}},wardrobeVideo:{resumeReview:"Resume scan {{index}} \xb7 {{count}} items",reviewRestoreFailed:"Could not restore saved scans. Please try again.",reviewUnavailable:"{{count}} saved scan(s) could not be read. Your files have been kept. Other saved scans are still available.",pendingScans:"Saved scans",pendingScansDescription:"These scans are waiting for analysis. Open this screen while online to resume.",queuedPhoto:"Photo {{index}}",queuedVideo:"Video {{index}}",queueStatus_pending:"Waiting",queueStatus_processing:"Analyzing",queueStatus_failed:"Needs attention",retryScan:"Retry",removeScan:"Remove",removeScanConfirmation:"Remove this saved scan and its temporary media? Your original photo or video wi