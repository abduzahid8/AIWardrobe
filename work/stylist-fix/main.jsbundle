43\u0434\u0430 \u0438\u0434\u0451\u0442\u0435, \u0441\u0442\u0438\u043b\u044c (old money, \u043a\u043b\u0430\u0441\u0441\u0438\u043a\u0430\u2026), \u0431\u044e\u0434\u0436\u0435\u0442 (1 500 000 UZS)\u2026",promptPlaceholderShort:"\u041a\u0443\u0434\u0430 \u0438\u0434\u0451\u0442\u0435, \u0441\u0442\u0438\u043b\u044c, \u0431\u044e\u0434\u0436\u0435\u0442 (1 500 000 UZS)\u2026",generate:"\u0421\u0433\u0435\u043d\u0435\u0440\u0438\u0440\u043e\u0432\u0430\u0442\u044c",description1:"\u041f\u043e\u0434\u043e\u0431\u0440\u0430\u043d\u043d\u044b\u0439 {{style}} \u043e\u0431\u0440\u0430\u0437 \u0438\u0437 \u0432\u0430\u0448\u0435\u0433\u043e \u0433\u0430\u0440\u0434\u0435\u0440\u043e\u0431\u0430.",description2:"\u042d\u043b\u0435\u0433\u0430\u043d\u0442\u043d\u044b\u0439 {{style}} \u0430\u043d\u0441\u0430\u043c\u0431\u043b\u044c \u0441 \u0441\u0431\u0430\u043b\u0430\u043d\u0441\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u043c\u0438 \u043f\u0440\u043e\u043f\u043e\u0440\u0446\u0438\u044f\u043c\u0438.",description3:"\u0418\u0437\u044f\u0449\u043d\u044b\u0439 {{style}} \u043e\u0431\u0440\u0430\u0437, \u0438\u0434\u0435\u0430\u043b\u044c\u043d\u043e \u043f\u043e\u0434\u0445\u043e\u0434\u044f\u0449\u0438\u0439 \u0434\u043b\u044f \u0441\u043b\u0443\u0447\u0430\u044f.",tip1_1:"\u0414\u043e\u0431\u0430\u0432\u044c\u0442\u0435 \u043d\u0435\u043d\u0430\u0432\u044f\u0437\u0447\u0438\u0432\u044b\u0435 \u0430\u043a\u0441\u0435\u0441\u0441\u0443\u0430\u0440\u044b",tip1_2:"\u0414\u0435\u0440\u0436\u0438\u0442\u0435 \u0446\u0432\u0435\u0442\u0430 \u0442\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u043c\u0438 \u0434\u043b\u044f \u0441\u0432\u044f\u0437\u043d\u043e\u0441\u0442\u0438",tip2_1:"\u0414\u043e\u0431\u0430\u0432\u044c\u0442\u0435 \u043a\u043e\u0436\u0430\u043d\u044b\u0439 \u0440\u0435\u043c\u0435\u043d\u044c \u0438 \u0447\u0430\u0441\u044b",tip2_2:"\u041d\u043e\u0441\u0438\u0442\u0435 \u0432\u0435\u0440\u0445\u043d\u044e\u044e \u043e\u0434\u0435\u0436\u0434\u0443 \u0441\u043b\u04