drobe-first: reference owned items before suggesting shop buys.','Honest about gaps: if the wardrobe lacks shoes/a layer, say so and offer one shop fix.','Cite shop prices when recommending buys. If the user names a budget, shop items in a look must sum to that cap or less (owned pieces cost 0).','One question at a time. End with a follow-up or 3 tappable suggestions.','Never repeat the same suggestion twice in one session.'],n={old_money:{id:'old_money',label:'Old Money',vibe:'Quiet luxury. Tonal, timeless, textured \u2014 Ralph Lauren / Loro Piana register.',palette:['navy','cream','camel','beige','burgundy','forest','white','charcoal'],fabrics:['cashmere','merino','linen','tweed','flannel','suede'],pairing:'Blazer or cardigan over knit polo/oxford + pleated trousers/chinos + loafers (penny/bit/tassel \u2014 structured enough for tailoring).',avoid:'Graphics, hoodies, cargos, chunky sneakers, black-as-default. Driving moccasins sit a tier below loafers \u2014 Riviera-casual, never with tailoring.'},semi_classic:{id:'semi_classic',label:'Semi-Classic',vibe:'Refined everyday. Tailored touches, relaxed comfort \u2014 Massimo Dutti / Arket.',palette:['navy','cream','beige','olive','burgundy','light blue','brown'],fabrics:['merino','cotton','linen','poplin','suede'],pairing:'Cardigan or unstructured blazer + tee/knit polo + chinos/jeans + loafers or clean sneakers.',avoid:'Hoodies, graphics, cargos, neon, ripped denim.'},minimalist:{id:'minimalist',label:'Minimalist',vibe:'Quiet, clean, intentional \u2014 COS / The Row. Cut and texture do the talking.',palette:['black','white','grey','beige','navy','stone','cream'],fabrics:['merino','wool','cotton','linen','cashmere'],pairing:'Monochrome column + one texture contrast. Minimal leather sneakers or loafers.',avoid:'Logos, prints, neon, color-blocking, chunky runners.'},business_casual:{id:'business_casual',label:'Modern Professional',vibe:'Sharp but comfortable. Textured blazer + knit polo + tailored trousers.',palette:['navy','charcoal','tan','white','light blue','cream','burgundy'],fabrics:['wool','poplin','flannel','tweed','merino'],pairing:'Navy blazer (metal buttons) + oxford/knit polo + chinos/trousers + loafers/derbies (never driving moccasins at work).',avoid:'Hoodies, graphics, cargos, black-as-default, square-toe shoes, driving moccasins with tailoring.'},casual:{id:'casual',label:'Smart Casual',vibe:'Relaxed but intentional. Knit tee + chinos/jeans + clean sneakers or loafers.',palette:['navy','white','grey','olive','cream','light blue','burgundy'],fabrics:['cotton','linen','denim','knit','suede'],pairing:'Knit tee/polo + chinos or dark jeans + minimal sneakers, loafers, or desert boots.',avoid:'Sweatpants, basketball shorts, graphic hoodies, athletic runners with trousers.'},classic:{id:'classic',label:'Classic Menswear',vibe:'Savile-Row rooted. Suits or sport-jacket separates, high-rise trousers, proper shoes.',palette:['navy','charcoal','cream','burgundy','camel','forest','light blue'],fabrics:['flannel','tweed','herringbone','cashmere','linen','poplin'],pairing:'Sport jacket + large-collar shirt/knit polo + 19-20cm-hem trousers + oxfords/derbies/loafers (structured shoes only \u2014 no drivers).',avoid:'Streetwear with tailoring, black everyday, exotic leathers, narrow lapels, driving moccasins with suits.'}};function l(t){var o=(t||'').toLowerCase().replace(/[\s-]+/g,'_');return n[o]??n.casual}var u=['1. Understand: occasion + weather + style + constraints (avoid colors/patterns) + budget if given.','2. Retrieve: owned items first, shop only for missing/sparse slots; skip shop pieces over remaining budget.','3. Rank: style fit \xd7 formality coherence \xd7 color harmony \xd7 novelty.','4. Compose: top+bottom+shoes always; layer only when cold or style demands.','5. Validate: no reject-list pieces, no formal-layer-with-shorts, shoes present.','6. Diversify: 3 looks must differ by \u22652 items; rotate anchor-adjacent slots.','7. Explain: 1 vivid sentence + 2 tips naming fit, fabric, or color logic.'];var c={en:{tipPrefix:'Stick to',date:'For date night, go polished but effortless. {tip} Add one texture contrast \u2014 suede loafers or a knit layer \u2014 and you\'re set. Fancy or casual spot?',work:'For work, keep it sharp: textured blazer, clean base layer, tailored trousers. {tip} Want me to build it from your wardrobe?',party:'Time to stand out \u2014 keep the silhouette clean, let one piece do the talking. {tip} What\'s the dress code?',weather:'Layer for the weather: base top + outer layer + bottom + weatherproof shoes. Keep the base tonal with the layer so it reads intentional. What\'s the temp?',budget:'I\'ll keep shop pieces within your budget \u2014 clothes you already own count as $0. Tell me the max you want to spend and I\'ll pick priced catalog items that fit.',shoes:'Shoes set the formality. For {label}: {avoid}. Tell me the outfit and I\'ll match the pair.',fallback:'I\'m {name} \u2014 tell me the occasion and I\'ll build 3 distinct looks from your wardrobe. {tip}',suggestions:{date:['Fancy dinner look','Casual date outfit','What shoes go with this?'],work:['Build work outfit','Business casual tips','Interview outfit help'],party:['Cocktail look','Wedding guest outfit','Smart party style'],weather:['Cold-weather outfit','Rainy day look','Light jacket style'],budget:['Outfit under $100','Outfit under $200','Use only my wardrobe'],shoes:['Match shoes to outfit','Loafer vs sneaker?','Build full outfit'],fallback:['Date night outfit','Work outfit','Weekend casual look']}},ru:{tipPrefix:'\u0414\u0435\u0440\u0436\u0438\u0442\u0435\u0441\u044c',date:'\u0414\u043b\u044f \u0441\u0432\u0438\u0434\u0430\u043d\u0438\u044f \u2014 polished, \u043d\u043e \u043d\u0435\u043f\u0440\u0438\u043d\u0443\u0436\u0434\u0451\u043d\u043d\u043e. {tip} \u0414\u043e\u0431\u0430\u0432\u044c\u0442\u0435 \u043e\u0434\u0438\u043d \u0444\u0430\u043a\u0442\u0443\u0440\u043d\u044b\u0439 \u0430\u043a\u0446\u0435\u043d\u0442 \u2014 \u0437\u0430\u043c\u0448\u0435\u0432\u044b\u0435 \u043b\u043e\u0444\u0435\u0440\u044b \u0438\u043b\u0438 \u0442\u0440\u0438\u043a\u043e\u0442\u0430\u0436\u043d\u044b\u0439 \u0441\u043b\u043e\u0439 \u2014 \u0438 \u043e\u0431\u0440\u0430\u0437 \u0433\u043e\u0442\u043e\u0432. \u0420\u0435\u0441\u0442\u043e\u0440\u0430\u043d \u0438\u043b\u0438 \u0447\u0442\u043e-\u0442\u043e \u043f\u0440\u043e\u0449\u0435?',work:'\u0414\u043b\u044f \u0440\u0430\u0431\u043e\u0442\u044b \u0434\u0435\u0440\u0436\u0438\u0442\u0435 \u043b\u0438\u043d\u0438\u044e \u0441\u0442\u0440\u043e\u0433\u043e: \u0444\u0430\u043a\u0442\u0443\u0440\u043d\u044b\u0439 \u0431\u043b\u0435\u0439\u0437\u0435\u0440, \u0447\u0438\u0441\u0442\u044b\u0439 \u0431\u0430\u0437\u043e\u0432\u044b\u0439 \u0441\u043b\u043e\u0439, tailored trousers. {tip} \u0421\u043e\u0431\u0440\u0430\u0442\u044c \u043e\u0431\u0440\u0430\u0437 \u0438\u0437 \u0432\u0430\u0448\u0435\u0433\u043e \u0433\u0430\u0440\u0434\u0435\u0440\u043e\u0431\u0430?',party:'\u0412\u0440\u0435\u043c\u044f \u0432\u044b\u0434\u0435\u043b\u044f\u0442\u044c\u0441\u044f \u2014 \u0434\u0435\u0440\u0436\u0438\u0442\u0435 \u0441\u0438\u043b\u0443\u044d\u0442 \u0447\u0438\u0441\u0442\u044b\u043c, \u043f\u0443\u0441\u0442\u044c \u0433\u043e\u0432\u043e\u0440\u0438\u0442 \u043e\u0434\u043d\u0430 \u0432\u0435\u0449\u044c. {tip} \u041a\u0430\u043a\u043e\u0439 \u0434\u0440\u0435\u0441\u0441-\u043a\u043e\u0434?',weather:'\u041e\u0434\u0435\u0432\u0430\u0439\u0442\u0435\u0441\u044c \u043f\u043e \u043f\u043e\u0433\u043e\u0434\u0435: \u0431\u0430\u0437\u043e\u0432\u044b\u0439 \u0442\u043e\u043f + \u0432\u0435\u0440\u0445\u043d\u0438\u0439 \u0441\u043b\u043e\u0439 + \u043d\u0438\u0437 + \u043d\u0435\u043f\u0440\u043e\u043c\u043e\u043a\u0430\u0435\u043c\u0430\u044f \u043e\u0431\u0443\u0432\u044c. \u0414\u0435\u0440\u0436\u0438\u0442\u0435 \u0431\u0430\u0437\u0443 \u0432 \u0442\u043e\u043d \u0441\u043b\u043e\u044e \u2014 \u0442\u0430\u043a \u0432\u044b\u0433\u043b\u044f\u0434\u0438\u0442 \u043f\u0